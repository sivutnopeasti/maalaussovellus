# Lähettäjän tiedot (vaaditaan --send). Postiosoite tarvitaan markkinointiviestiin.
OUTREACH_FROM_NAME="UGC Suomi"
OUTREACH_FROM_EMAIL="oma@gmail.com"
OUTREACH_POSTAL_ADDRESS="Yrityksen nimi, katuosoite, postinumero ja toimipaikka"

# --- Ilmainen lähetys (valitse yksi) ---
# Gmail: Google-tili → 2-vaiheinen vahvistus → Sovellussalasana
MAIL_PROVIDER=gmail
SMTP_USER=oma@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx

# Vaihtoehto: Brevo ilmainen SMTP (~300 viestiä/vrk)
# MAIL_PROVIDER=brevo
# SMTP_USER=brevo-login
# SMTP_PASS=brevo-smtp-avain

# Tai oma SMTP:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Valinnainen Meta Ad Library (ilmainen token, ei pakollinen)
# https://www.facebook.com/ads/library/api/
META_ACCESS_TOKEN=

# --- Valinnainen tekoäly (ainoa tyypillinen kulu) ---
# Ilman näitä automaatio toimii ilmaiseksi: PRH + sivusto + Instagram + Gmail.
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# Ilmaisia / lähes ilmaisia vaihtoehtoja:
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.1-8b-instant
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=openai/gpt-oss-20b:free

# Oletuskynnykset. Yritys on "hyvä", jos yksikin raja ylittyy.
MIN_FOLLOWERS=3000
MIN_MEDIAN_LIKES=30
MIN_MEDIAN_COMMENTS=3
MIN_MEDIAN_VIEWS=1000
