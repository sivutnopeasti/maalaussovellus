# Lähettäjän tiedot. Viestiä ei lähetetä, jos nimi, sähköposti tai postiosoite puuttuu.
OUTREACH_FROM_NAME="UGC Suomi"
OUTREACH_FROM_EMAIL="tuki@ugcsuomi.fi"
OUTREACH_POSTAL_ADDRESS="Yrityksen nimi, katuosoite, postinumero ja toimipaikka"

# SMTP. Tarvitaan vain komennolla --send.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Valinnainen. Ilman tätä maksettua mainontaa ei päätellä.
# Meta Ad Library API: https://www.facebook.com/ads/library/api/
META_ACCESS_TOKEN=

# Oletuskynnykset. Yritys on "hyvä", jos yksikin raja ylittyy.
MIN_FOLLOWERS=3000
MIN_MEDIAN_LIKES=30
MIN_MEDIAN_COMMENTS=3
MIN_MEDIAN_VIEWS=1000
